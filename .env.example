# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL, found in Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key, found in Supabase → Project Settings → API
# Used by the public site for read-only access (protected by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key, found in Supabase → Project Settings → API
# SECRET — server-only. Bypasses RLS. Used by the admin panel and the
# Stripe webhook. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Secret key, found in Stripe → Developers → API keys
STRIPE_SECRET_KEY=

# Webhook signing secret, found in Stripe → Developers → Webhooks
# (created after adding the endpoint https://yourdomain.com/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------------
# Single password used to log into /admin. Choose a long, random value.
# It also signs the admin session cookie, so changing it logs out all
# active admin sessions.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL of the deployed site, no trailing slash. Used to build
# Stripe Checkout success/cancel URLs.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Public contact email shown on the /contact page.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
